<%- include('../partials/page-header', {
  title: 'Edit Warehouse',
  subtitle: 'Update warehouse details, address and operating status.'
}) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="ss-card">
      <header class="ss-card__header">
        <h2 class="ss-card__title">Warehouse Details</h2>
      </header>

      <div class="ss-card__body">
        <% if (errors.form) { %>
          <div class="ss-alert ss-alert--danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span><%= errors.form %></span>
          </div>
        <% } %>

        <form class="ss-form" method="post" action="/warehouses/<%= values.id || warehouse.id %>/edit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <%- include('./_form_fields') %>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-4">
            <a href="/warehouses" class="ss-btn ss-btn--secondary">Cancel</a>
            <button type="submit" class="ss-btn ss-btn--primary">Update Warehouse</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
