<section class="ss-card ss-auth__card">
  <header class="ss-card__header">
    <div>
      <h2 class="ss-card__title"><%= title %></h2>
      <% if (typeof subtitle !== 'undefined' && subtitle) { %>
        <p class="ss-card__subtitle"><%= subtitle %></p>
      <% } %>
    </div>
  </header>

  <div class="ss-card__body <%= typeof tight !== 'undefined' && tight ? 'ss-card__body--tight' : '' %>">
    <%- body %>
  </div>

  <% if (typeof footer !== 'undefined' && footer) { %>
    <footer class="ss-card__footer"><%- footer %></footer>
  <% } %>
</section>