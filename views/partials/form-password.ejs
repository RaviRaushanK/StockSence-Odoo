<div class="ss-field">
  <label class="ss-field__label" for="<%= name %>">
    <%= label %><% if (required) { %><span class="ss-field__required" aria-hidden="true">*</span><% } %>
  </label>

  <div class="ss-field__control">
    <% var hasIcon = typeof icon !== 'undefined' && icon; %>
    <% if (hasIcon) { %>
      <span class="ss-field__icon"><i class="bi <%= icon %>" aria-hidden="true"></i></span>
    <% } %>

    <input
      class="ss-input <%= hasIcon ? 'ss-input--with-icon' : '' %> ss-input--with-action <%= errors[name] ? 'ss-input--error' : '' %>"
      id="<%= name %>"
      name="<%= name %>"
      type="password"
      value=""
      placeholder="<%= placeholder %>"
      autocomplete="<%= autocomplete %>"
      <%= required ? 'required' : '' %>
      <%= errors[name] ? 'aria-invalid="true"' : '' %>
      <%= errors[name] ? 'aria-describedby="' + name + '-error"' : '' %>
      data-password-input
      data-password-field="<%= name %>"
    />

    <button
      type="button"
      class="ss-field__action"
      aria-label="Show password"
      aria-pressed="false"
      data-password-toggle
    >
      <i class="bi bi-eye" aria-hidden="true"></i>
    </button>
  </div>

  <% if (errors[name]) { %>
    <span class="ss-field__error" id="<%= name %>-error" role="alert">
      <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
      <%= errors[name] %>
    </span>
  <% } %>
</div>