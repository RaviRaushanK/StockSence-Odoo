<div class="row g-3">
  <div class="col-12">
    <div class="ss-field">
      <label class="ss-field__label">Warehouse</label>
      <input type="text" class="ss-input" value="<%= warehouse.name %> (<%= warehouse.code %>)" disabled />
    </div>
  </div>
  <div class="col-12 col-md-8">
    <div class="ss-field">
      <label class="ss-field__label" for="name">Location Name<span class="ss-field__required">*</span></label>
      <input type="text" id="name" name="name" class="ss-input <%= errors.name ? 'ss-input--error' : '' %>" placeholder="e.g. Aisle 3 Shelf B" value="<%= values.name || '' %>" required />
      <% if (errors.name) { %><span class="ss-field__error"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> <%= errors.name %></span><% } %>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="ss-field">
      <label class="ss-field__label" for="code">Location Code<span class="ss-field__required">*</span></label>
      <input type="text" id="code" name="code" class="ss-input <%= errors.code ? 'ss-input--error' : '' %>" placeholder="e.g. A3-SB" value="<%= values.code || '' %>" required />
      <span class="ss-field__hint">Must be unique within <%= warehouse.name %>.</span>
      <% if (errors.code) { %><span class="ss-field__error"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> <%= errors.code %></span><% } %>
    </div>
  </div>
  <div class="col-12">
    <div class="ss-field">
      <label class="ss-field__label" for="description">Description</label>
      <textarea id="description" name="description" class="ss-textarea" rows="3" placeholder="Optional notes about location specifications or capacity..."><%= values.description || '' %></textarea>
    </div>
  </div>
  <div class="col-12">
    <div class="ss-field">
      <label class="ss-checkbox">
        <input type="checkbox" name="isActive" value="1" class="ss-checkbox__input" <%= values.isActive === false || values.isActive === '0' ? '' : 'checked' %> />
        <span>Active</span>
      </label>
      <span class="ss-field__hint">Inactive locations cannot receive or store items.</span>
    </div>
  </div>
</div>
