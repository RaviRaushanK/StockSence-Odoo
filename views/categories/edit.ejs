<%- include('../partials/page-header', {
  title: 'Edit Category',
  subtitle: 'Update category details and availability.'
}) %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="ss-card">
      <header class="ss-card__header">
        <h2 class="ss-card__title">Category Details</h2>
      </header>

      <div class="ss-card__body">
        <% if (errors.form) { %>
          <div class="ss-alert ss-alert--danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span><%= errors.form %></span>
          </div>
        <% } %>

        <form class="ss-form" method="post" action="/categories/<%= values.id || category.id %>/edit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="ss-field">
            <label class="ss-field__label" for="name">
              Category Name<span class="ss-field__required">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="ss-input <%= errors.name ? 'ss-input--error' : '' %>"
              value="<%= values.name !== undefined ? values.name : category.name %>"
              required
            />
            <% if (errors.name) { %>
              <span class="ss-field__error">
                <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                <%= errors.name %>
              </span>
            <% } %>
          </div>

          <div class="ss-field">
            <label class="ss-field__label" for="description">Description</label>
            <textarea
              id="description"
              name="description"
              class="ss-textarea"
              rows="3"
            ><%= values.description !== undefined ? values.description : (category.description || '') %></textarea>
          </div>

          <div class="ss-field">
            <label class="ss-checkbox">
              <input
                type="checkbox"
                name="isActive"
                value="1"
                class="ss-checkbox__input"
                <%= (values.isActive !== undefined ? (values.isActive === true || values.isActive === '1' || values.isActive === 'on') : category.isActive) ? 'checked' : '' %>
              />
              <span>Active</span>
            </label>
            <span class="ss-field__hint">Inactive categories cannot be assigned to new products.</span>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="/categories" class="ss-btn ss-btn--secondary">Cancel</a>
            <button type="submit" class="ss-btn ss-btn--primary">Update Category</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
