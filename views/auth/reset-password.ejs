<section class="ss-card ss-auth__card">
  <div class="ss-auth__header">
    <h1 class="ss-auth__title">Reset password</h1>
    <p class="ss-auth__subtitle">Choose a new password for your <%= appName %> account.</p>
  </div>

  <%- include('../partials/flash-message') %>

  <form class="ss-form" method="post" action="/reset-password" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="email" value="<%= values.email || '' %>" />
    <input type="hidden" name="otp" value="<%= values.otp || '' %>" />

    <%- include('../partials/form-password', {
      name: 'password',
      label: 'New password',
      placeholder: 'Enter a new password',
      autocomplete: 'new-password',
      required: true,
    }) %>

    <ul class="ss-password-rules" data-password-rules="password">
      <li data-rule="length">
        <i class="bi bi-circle" aria-hidden="true"></i>
        <span>At least 8 characters</span>
      </li>
      <li data-rule="letter">
        <i class="bi bi-circle" aria-hidden="true"></i>
        <span>At least one letter</span>
      </li>
      <li data-rule="number">
        <i class="bi bi-circle" aria-hidden="true"></i>
        <span>At least one number</span>
      </li>
    </ul>

    <%- include('../partials/form-password', {
      name: 'confirmPassword',
      label: 'Confirm new password',
      placeholder: 'Re-enter your new password',
      autocomplete: 'new-password',
      required: true,
    }) %>

    <button type="submit" class="ss-btn ss-btn--primary ss-btn--md ss-btn--block" data-submit-button>
      <span data-submit-label>Reset password</span>
    </button>
  </form>

  <p class="ss-auth__footer"><a href="/login">Back to sign in</a></p>
</section>