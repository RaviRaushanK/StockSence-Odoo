<section class="ss-card ss-auth__card">
  <div class="ss-auth__header">
    <h1 class="ss-auth__title">Forgot password</h1>
    <p class="ss-auth__subtitle">
      Enter the email address linked to your account and we&apos;ll send you a 6-digit OTP.
    </p>
  </div>

  <%- include('../partials/flash-message') %>

  <div class="ss-alert ss-alert--info mb-4">
    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
    <span>
      If the email address is registered, a 6-digit OTP valid for 10 minutes will be sent.
      If delivery is unavailable, you will see a message asking you to try again later.
    </span>
  </div>

  <form class="ss-form" method="post" action="/forgot-password" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <%- include('../partials/form-field', {
      name: 'email',
      label: 'Email address',
      type: 'email',
      icon: 'bi-envelope',
      placeholder: 'you@company.com',
      autocomplete: 'email',
      required: true,
    }) %>

    <button type="submit" class="ss-btn ss-btn--primary ss-btn--md ss-btn--block" data-submit-button>
      <span data-submit-label>Send OTP</span>
    </button>
  </form>

  <p class="ss-auth__footer">
    Remembered your password? <a href="/login">Back to sign in</a>
  </p>
</section>