<%- include('../../partials/page-header', { title: `Transfer ${transfer.transferNumber}`, subtitle: 'Internal stock movement between locations.' }) %>

<div class="row g-3">
  <div class="col-12 col-lg-8">
    <div class="ss-card">
      <header class="ss-card__header"><h2 class="ss-card__title">Transfer Information</h2><span class="ss-badge <%= transfer.status === 'DONE' ? 'ss-badge--success' : (transfer.status === 'CANCELED' ? 'ss-badge--neutral' : 'ss-badge--warning') %>"><%= transfer.status %></span></header>
      <div class="ss-card__body">
        <dl class="row mb-0">
          <dt class="col-sm-4 text-secondary">Transfer No.</dt><dd class="col-sm-8"><code><%= transfer.transferNumber %></code></dd>
          <dt class="col-sm-4 text-secondary">From</dt><dd class="col-sm-8 fw-semibold"><%= transfer.sourceWarehouse ? transfer.sourceWarehouse.name : '—' %> / <%= transfer.sourceLocation ? `${transfer.sourceLocation.name} (${transfer.sourceLocation.code})` : '—' %></dd>
          <dt class="col-sm-4 text-secondary">To</dt><dd class="col-sm-8 fw-semibold"><%= transfer.destinationWarehouse ? transfer.destinationWarehouse.name : '—' %> / <%= transfer.destinationLocation ? `${transfer.destinationLocation.name} (${transfer.destinationLocation.code})` : '—' %></dd>
          <dt class="col-sm-4 text-secondary">Notes</dt><dd class="col-sm-8"><%= transfer.notes || '—' %></dd>
          <dt class="col-sm-4 text-secondary">Created By</dt><dd class="col-sm-8"><%= transfer.creator ? transfer.creator.fullName : '—' %></dd>
          <dt class="col-sm-4 text-secondary">Validated By</dt><dd class="col-sm-8"><%= transfer.validator ? transfer.validator.fullName : '—' %></dd>
          <dt class="col-sm-4 text-secondary">Validated At</dt><dd class="col-sm-8"><%= transfer.validatedAt ? new Date(transfer.validatedAt).toLocaleString() : '—' %></dd>
        </dl>
      </div>
    </div>
    <div class="ss-card mt-3">
      <header class="ss-card__header"><h2 class="ss-card__title">Items</h2></header>
      <div class="ss-table-wrapper"><table class="ss-table">
        <thead><tr><th>Product</th><th>SKU</th><th class="text-end">Quantity</th><th>Unit</th></tr></thead>
        <tbody>
          <% (transfer.items || []).forEach(function(it) { %>
            <tr><td class="fw-semibold"><%= it.product ? it.product.name : 'Unknown' %></td><td><code><%= it.product ? it.product.sku : '—' %></code></td><td class="text-end font-monospace fw-bold"><%= it.quantity %></td><td><%= it.unitOfMeasure || (it.product ? it.product.unitOfMeasure : '') %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
    </div>
  </div>
  <div class="col-12 col-lg-4">
    <div class="ss-card"><div class="ss-card__body d-grid gap-2">
      <a href="/operations/transfers" class="ss-btn ss-btn--secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
      <% if (transfer.status !== 'DONE' && transfer.status !== 'CANCELED') { %>
        <form method="post" action="/operations/transfers/<%= transfer.id %>/validate"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button type="submit" class="ss-btn ss-btn--primary w-100" data-confirm="Validate transfer <%= transfer.transferNumber %>? Stock will move atomically."><i class="bi bi-check-circle" aria-hidden="true"></i> Validate &amp; Move Stock</button></form>
        <form method="post" action="/operations/transfers/<%= transfer.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button type="submit" class="ss-btn ss-btn--secondary w-100" data-confirm="Cancel transfer <%= transfer.transferNumber %>? No stock will change."><i class="bi bi-x-circle" aria-hidden="true"></i> Cancel Document</button></form>
      <% } else if (transfer.status === 'DONE') { %>
        <div class="ss-alert ss-alert--success mb-0" role="status"><i class="bi bi-lock-fill" aria-hidden="true"></i><span>Validated documents are read-only. Paired TRANSFER_OUT / TRANSFER_IN entries are in Move History.</span></div>
      <% } else { %>
        <div class="ss-alert ss-alert--danger mb-0" role="status"><i class="bi bi-x-circle" aria-hidden="true"></i><span>This document was canceled. No stock was changed.</span></div>
      <% } %>
    </div></div>
  </div>
</div>
