# Copy this file to server/.env and fill in real values.
# Never commit the resulting .env file.

# Application
NODE_ENV=development
PORT=5000
APP_NAME=StockSense
APP_VERSION=1.0.0
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# JSON Web Token
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
JWT_ISSUER=stocksense-api

# Auth cookie
COOKIE_NAME=ss_access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stocksense
DB_USER=stocksense_user
DB_PASSWORD=replace-with-database-password
DB_LOG_SQL=false

# Outbound email - required by the OTP password reset flow (planned phase)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=StockSense <no-reply@example.com>

# OTP policy - consumed once the email delivery integration is configured
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
